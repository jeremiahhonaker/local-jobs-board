# Local Jobs Board — environment variables.
# Copy to .env for local dev (optional — everything below has a local default).
# In production (Render), set these in the dashboard. NEVER commit real secrets.

# Public base URL of the deployed app (used in magic-link emails).
# Local default: http://localhost:3000
APP_URL=https://jobs.example.com

# Email of the board owner. Only this account sees board-wide fee totals.
OWNER_EMAIL=you@example.com

# --- Database (Render persistent disk) ---
# In production the SQLite file lives on the persistent disk mounted at
# /data (see render.yaml) — no separate database account is needed.
# Local default: ./data/local.db
LOCAL_DB_PATH=/data/app.db

# --- Database (Turso, hosted SQLite) — OPTIONAL, not used now ---
# The Turso code path is still in the app and can be re-enabled later by
# setting these two variables in Render. When TURSO_DATABASE_URL is set,
# it takes priority over LOCAL_DB_PATH.
# TURSO_DATABASE_URL=<redacted>
# TURSO_AUTH_TOKEN=<your-turso-token>

# --- Email (Resend, magic-link sign-in) ---
# Create a free account at https://resend.com. The free tier covers early volume.
# If left unset, magic links are printed to the server console (dev only).
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=Local Jobs Board <noreply@example.com>

# --- Optional ---
PORT=3000
NODE_ENV=production

# --- Dev only: NEVER enable in production ---
# When 1, the magic-link endpoint returns the sign-in link in its JSON
# response so local end-to-end tests can sign in without email.
# DEV_AUTH_DEBUG=1
